# Copy this file to .env and fill in your real values.
# Find these at https://sanity.io/manage — select your project.

VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# Find these at https://dashboard.emailjs.com — Email Services / Email Templates / Account > General.
# Without these, the "write me" form falls back to opening the visitor's own email client.
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
