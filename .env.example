# Copy this file to .env and fill in your real values.
# Find these at https://sanity.io/manage — select your project.

VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# Get this at https://web3forms.com — enter your email, no signup needed.
# Without it, the "write me" form falls back to opening the visitor's own email client.
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here
